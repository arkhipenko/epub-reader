Adds the targets ios and ios-simulator to koreader-base (commit b153a4a2).
Changed files: Makefile.defs, cmake/CMakeLists.txt.
Changes made 2026-11-10 by Anatoli Arkhipenko for this app (native/build-ios.sh).
koreader-base is under the GNU Affero General Public License version 3, and
so are these changes.

diff --git a/Makefile.defs b/Makefile.defs
index b80474dc..3971e162 100644
--- a/Makefile.defs
+++ b/Makefile.defs
@@ -213,6 +213,17 @@ else ifeq ($(TARGET), bookeen)
 	BOOKEEN=1
 	GLIBC_VERSION_MAX = 2.11
 	USE_LJ_WPACLIENT=1
+else ifneq (,$(filter ios ios-simulator,$(TARGET)))
+	# epub-reader: static libraries for iOS (not an upstream KOReader target).
+	# The CHOST compiler wrappers (native/build-ios.sh) select the SDK and the
+	# target triple. IOS_SDK_PATH must name the same SDK.
+	IOS=1
+	DARWIN=1
+	MONOLIBTIC=1
+	CHOST?=aarch64-apple-darwin
+	ifeq (,$(IOS_SDK_PATH))
+	  $(error IOS_SDK_PATH is not set)
+	endif
 else ifndef TARGET
 	# if TARGET is not defined we will build an emulator on current machine
 	EMULATE_READER=1
@@ -228,7 +239,11 @@ endif
 ifdef DARWIN
   USE_CLANG = 1
   BREW_PREFIX := $(shell brew --prefix)
-  export MACOSX_DEPLOYMENT_TARGET := $(or $(MACOSX_DEPLOYMENT_TARGET),$(shell sw_vers -productVersion))
+  ifdef IOS
+    unexport MACOSX_DEPLOYMENT_TARGET
+  else
+    export MACOSX_DEPLOYMENT_TARGET := $(or $(MACOSX_DEPLOYMENT_TARGET),$(shell sw_vers -productVersion))
+  endif
 endif
 
 ifneq ($(CCACHE),)
@@ -311,7 +326,7 @@ else ifdef CHOST
   AR := $(call ensure_exe_abspath,$(CHOST)-ar)
   LD := $(call ensure_exe_abspath,$(CHOST)-ld)
   NM := $(call ensure_exe_abspath,$(CHOST)-nm)
-  OBJCOPY := $(call ensure_exe_abspath,$(CHOST)-objcopy)
+  OBJCOPY := $(if $(DARWIN),,$(call ensure_exe_abspath,$(CHOST)-objcopy))
   RANLIB := $(call ensure_exe_abspath,$(CHOST)-ranlib)
 else
   STRIP := $(call ensure_exe_abspath,strip)
@@ -332,7 +347,7 @@ ifdef EMULATE_READER
 else
   HOSTAR := $(call ensure_exe_abspath,ar)
   HOSTLD := $(call ensure_exe_abspath,ld)
-  HOSTOBJCOPY := $(call ensure_exe_abspath,objcopy)
+  HOSTOBJCOPY := $(if $(DARWIN),,$(call ensure_exe_abspath,objcopy))
   HOSTRANLIB := $(call ensure_exe_abspath,ranlib)
 endif
 
@@ -793,7 +808,7 @@ set(CMAKE_COLOR_DIAGNOSTICS TRUE)
 # NOTE: use Linux for Android too (cf. https://github.com/taka-no-me/android-cmake and
 # https://android.googlesource.com/platform/ndk/+/master/build/cmake/android.toolchain.cmake)
 # In the meantime, I'll be sitting in the corner, crying hysterically.
-set(CMAKE_SYSTEM_NAME $(if $(DARWIN),Darwin,$(if $(WIN32),Windows,Linux)))
+set(CMAKE_SYSTEM_NAME $(if $(IOS),iOS,$(if $(DARWIN),Darwin,$(if $(WIN32),Windows,Linux))))
 
 # Target architecture.
 set(CMAKE_SYSTEM_PROCESSOR $(word 1,$(subst -,$(space),$(TARGET_MACHINE))))
@@ -879,6 +894,9 @@ $(if $(ANDROID),set(CMAKE_SYSTEM_VERSION 1))
 # Also disable versioning of shared objects.
 $(if $(ANDROID),set(CMAKE_PLATFORM_NO_VERSIONED_SONAME TRUE))
 
+# epub-reader: the iOS SDK. The compiler wrappers pass the target triple.
+$(if $(IOS),set(CMAKE_OSX_SYSROOT $(IOS_SDK_PATH)))
+
 # Search for programs in the build host directories.
 set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
 # For libraries and headers in the target directories.
@@ -1013,8 +1031,9 @@ else
 MESON_CROSS_TOOLCHAIN = $(CMAKE_DIR)/meson_cross_toolchain.ini
 MESON_HOST_TOOLCHAIN = $(CMAKE_DIR)/meson_host_toolchain.ini
 
-MESON_CROSS_SYSTEM = $(if $(ANDROID),android,linux)
-ifneq (,$(filter aarch64-%,$(TARGET_MACHINE)))
+MESON_CROSS_SYSTEM = $(if $(ANDROID),android,$(if $(IOS),darwin,linux))
+MESON_CROSS_SUBSYSTEM = $(if $(filter %-simulator,$(TARGET_MACHINE)),ios-simulator,ios)
+ifneq (,$(filter aarch64-% arm64-%,$(TARGET_MACHINE)))
   MESON_CROSS_CPU_FAMILY = aarch64
 else ifneq (,$(filter arm-% armv7a-%,$(TARGET_MACHINE)))
   MESON_CROSS_CPU_FAMILY = arm
@@ -1036,6 +1055,8 @@ system = '$(MESON_CROSS_SYSTEM)'
 cpu_family = '$(MESON_CROSS_CPU_FAMILY)'
 cpu = '$(MESON_CROSS_CPU)'
 endian = '$(MESON_CROSS_ENDIAN)'
+$(if $(IOS),subsystem = '$(MESON_CROSS_SUBSYSTEM)')
+$(if $(IOS),kernel = 'xnu')
 endef
 
 define meson_host_toolchain
diff --git a/cmake/CMakeLists.txt b/cmake/CMakeLists.txt
index 9acfa7a8..e9ba3c38 100644
--- a/cmake/CMakeLists.txt
+++ b/cmake/CMakeLists.txt
@@ -93,7 +93,8 @@ endfunction()
 # }}}.
 
 # Ensure `MACOSX_DEPLOYMENT_TARGET` is set, and `CMAKE_OSX_DEPLOYMENT_TARGET` matches.
-if(APPLE)
+# epub-reader: not on iOS, where the compiler target triple sets the minimum version.
+if(APPLE AND NOT IOS)
     if(NOT DEFINED ENV{MACOSX_DEPLOYMENT_TARGET} OR "$ENV{MACOSX_DEPLOYMENT_TARGET}" STREQUAL "")
         message(FATAL_ERROR "$MACOSX_DEPLOYMENT_TARGET is not set")
     endif()
